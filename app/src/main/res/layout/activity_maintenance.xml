<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maintenance reminders" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvBikeName" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView style="@style/SectionTitle" android:text="Engine oil" />
        <com.google.android.material.card.MaterialCardView style="@style/AppCard"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/tvOilStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" />
        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Last oil change date" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnOilDate" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:hint="Odometer at last oil change (km)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOilKm" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:hint="Service interval (km)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOilInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnOilSave"  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Save / reschedule" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnOilDone" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mark as completed" />
        </LinearLayout></com.google.android.material.card.MaterialCardView>
        <TextView style="@style/SectionTitle" android:text="Air filter" />
        <com.google.android.material.card.MaterialCardView style="@style/AppCard"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/tvAirStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" />
        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Installation date" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAirInstallDate" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:hint="Installation odometer (km, optional)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAirInstallKm" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Next reminder date" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAirNextDate" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAirClearDate" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Clear reminder date" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:hint="Reminder odometer (km, optional)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAirNextKm" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAirSave"  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Save / reschedule" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAirDone" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mark as completed" />
        </LinearLayout></com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
